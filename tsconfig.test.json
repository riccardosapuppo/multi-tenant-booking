{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
