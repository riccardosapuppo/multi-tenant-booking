# Riscontri veri che non sono segreti, e perché.
#
# Ognuno è stato letto. Nessuno apre qualcosa che esiste: sono la password di
# un database che nasce e muore con `docker compose up` sulla macchina di chi
# legge, le quattro credenziali dimostrative, e due variabili che leggono un
# valore invece di contenerlo.
#
# Le credenziali dimostrative stanno nel codice E nel README di proposito.
# Questo progetto dimostra un confine di permessi, e un confine su cui non si
# può stare da entrambi i lati è un'affermazione, non una dimostrazione: le
# quattro identità servono a vedere la differenza in un clic. Il database che
# aprono viene creato vuoto sulla macchina del lettore e buttato via insieme
# al contenitore.
#
# Non vale per i nomi aziendali e per le chiavi vere: quelli bloccano comunque,
# da qualunque file.
#
# Nota per chi scrive qui: le motivazioni non devono riprodurre il codice che
# scusano. Questo file viene esaminato come tutti gli altri, e una motivazione
# che cita la riga incriminata si fa segnalare da sola.

docker-compose.yml                       # password del PostgreSQL usa-e-getta della dimostrazione
.github/workflows/ci.yml                 # la stessa, per il servizio PostgreSQL della CI
backend/db/pools.js                      # legge POSTGRES_PASSWORD dall'ambiente, con un default per la demo
backend/auth/routes.js                   # una variabile che riceve il valore inviato dal client, non un valore scritto qui
web/src/app/shell/api.service.ts         # la firma del metodo che manda le credenziali all'API
backend/auth/passwords.js                # il testo "a password must be at least 8 characters"
backend/seed/demo.js                     # le quattro password dimostrative, documentate nel README
web/src/app/auth/sign-in.component.ts    # le stesse, come pulsanti sulla pagina di accesso
tools/walkthrough.mjs                    # le stesse, per guidare il sistema in esecuzione
README.md                                # la tabella che le elenca, che è metà della dimostrazione
