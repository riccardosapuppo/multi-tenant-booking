{
  "name": "multi-tenant-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "docker compose up --build",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc --noEmit -p apps/api/tsconfig.json && esbuild apps/api/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/main.js",
    "build:web": "ng build multi-tenant-booking",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@angular/common": "19.1.7",
    "@angular/compiler": "19.1.7",
    "@angular/core": "19.1.7",
    "@angular/forms": "19.1.7",
    "@angular/platform-browser": "19.1.7",
    "@angular/service-worker": "19.1.7",
    "express": "4.21.2",
    "pg": "8.13.1",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.1.8",
    "@angular/cli": "19.1.8",
    "@angular/compiler-cli": "19.1.7",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/sql.js": "1.4.9",
    "@types/supertest": "6.0.2",
    "esbuild": "0.24.2",
    "sql.js": "1.13.0",
    "supertest": "7.1.3",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
